{
  "name": "@yonggipo/repo-providers",
  "version": "0.1.0",
  "private": true,
  "description": "저장소 서비스(Bitbucket, GitHub) 연동을 여러 도구가 함께 쓰는 패키지",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "engines": {
    "node": ">=23.6"
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "typescript": "7.0.2"
  }
}
